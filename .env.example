# 둘 다 비워두면 "로컬 모드"로 돌아감 (이 브라우저 localStorage에만 저장)
# Supabase 대시보드 → Project Settings
#   URL: Data API → Project URL
#   KEY: API Keys → Publishable key (sb_publishable_...)
#        ⚠ Secret key(sb_secret_...)는 절대 넣지 말 것 — RLS를 무시함
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# (선택) 에러 알림 — Sentry 프로젝트 → Settings → Client Keys (DSN). 브라우저에 노출돼도 되는 값.
# 배포판(빌드)에서만 켜짐. 로컬 개발에선 비워둬도 됨
VITE_SENTRY_DSN=
